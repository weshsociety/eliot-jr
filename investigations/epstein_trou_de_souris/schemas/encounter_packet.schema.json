{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weshsociety.org/schemas/eliot-jr/investigation-encounter-packet.v1.json",
  "title": "Eliot-Jr investigation encounter packet",
  "description": "Paquet préparé après revue humaine pour une future rencontre transactionnelle. Sa validation n'écrit rien dans la mémoire.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "packet_sha256",
    "encounter_type",
    "investigation_id",
    "relation_id",
    "relation_candidate_sha256",
    "prepared_at_utc",
    "prepared_by",
    "source_attribution",
    "external_claim",
    "review",
    "epistemic_state",
    "eliot_learning_state",
    "safeguards"
  ],
  "properties": {
    "schema": {
      "const": "eliot-jr.investigation-encounter-packet.v1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^enc_[a-f0-9]{24}$"
    },
    "packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "encounter_type": {
      "const": "investigation_relation_candidate"
    },
    "investigation_id": {
      "const": "epstein_trou_de_souris"
    },
    "relation_id": {
      "type": "string",
      "pattern": "^rel_[a-f0-9]{24}$"
    },
    "relation_candidate_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prepared_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "prepared_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_attribution": {
      "$ref": "#/$defs/sourceAttribution"
    },
    "external_claim": {
      "$ref": "#/$defs/externalClaim"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "epistemic_state": {
      "$ref": "#/$defs/epistemicState"
    },
    "eliot_learning_state": {
      "$ref": "#/$defs/learningState"
    },
    "safeguards": {
      "$ref": "#/$defs/safeguards"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "entity_id", "entity_type"],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "entity_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{1,127}$"
            },
            {"type": "null"}
          ]
        },
        "entity_type": {
          "enum": [
            "person",
            "organization",
            "institution",
            "event",
            "place",
            "document",
            "concept",
            "unknown"
          ]
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "normalized"],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "normalized": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        }
      }
    },
    "sourceAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "source_state",
        "line_start",
        "line_end",
        "verbatim_excerpt",
        "claim_candidate_id"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "not": {"pattern": "(^|/)\\.\\.(/|$)"}
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_state": {
          "const": "unchanged"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "verbatim_excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "claim_candidate_id": {
          "type": "string",
          "pattern": "^claim_[0-9]{5,}$"
        }
      }
    },
    "externalClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "predicate",
        "object",
        "basis",
        "negated",
        "hypothetical",
        "causal_claim_in_source"
      ],
      "properties": {
        "subject": {"$ref": "#/$defs/entity"},
        "predicate": {"$ref": "#/$defs/predicate"},
        "object": {"$ref": "#/$defs/entity"},
        "basis": {
          "enum": [
            "explicit_sentence",
            "table",
            "metadata",
            "cooccurrence",
            "inference",
            "human_attestation",
            "guild_contribution"
          ]
        },
        "negated": {"type": "boolean"},
        "hypothetical": {"type": "boolean"},
        "causal_claim_in_source": {"type": "boolean"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "decision_type",
        "reviewed_by",
        "reviewed_at_utc",
        "comment",
        "reviewed_candidate_sha256",
        "explicit_human_confirmation"
      ],
      "properties": {
        "decision": {"const": "accepted_for_encounter"},
        "decision_type": {"enum": ["human", "collective"]},
        "reviewed_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "reviewed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "comment": {
          "type": "string",
          "maxLength": 4000
        },
        "reviewed_candidate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "explicit_human_confirmation": {"const": true}
      }
    },
    "epistemicState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_status", "causality", "contradictions"],
      "properties": {
        "truth_status": {"const": "not_assessed"},
        "causality": {"const": "not_established"},
        "contradictions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^rel_[a-f0-9]{24}$"
          }
        }
      }
    },
    "learningState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "conclusion_required"],
      "properties": {
        "status": {"const": "not_yet_processed"},
        "conclusion_required": {"const": false}
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_review_required",
        "memory_written",
        "journal_written",
        "core_modified",
        "octopus_modified",
        "publication_performed"
      ],
      "properties": {
        "human_review_required": {"const": true},
        "memory_written": {"const": false},
        "journal_written": {"const": false},
        "core_modified": {"const": false},
        "octopus_modified": {"const": false},
        "publication_performed": {"const": false}
      }
    }
  }
}
